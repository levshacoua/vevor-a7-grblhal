+
+[env:vevor_a7]
+platform = espressif32 @ 5.3.0  ; ESP-IDF v4.4.x
+framework = espidf
+board = esp32-s3-devkitc-1
+board_build.partitions = partitions_s3_8m.csv
+
+board_build.embed_files =
+    main/embedded/favicon.ico
+    main/embedded/ap_login.html
+    main/embedded/index.html.gz
+
+board_build.cmake_extra_args =
+    -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.esp32s3;sdkconfig_s3_8m"
+
+extra_scripts =
+    pre:scripts/set_progname.py
+
+build_flags =
+    -DCONFIG_IDF_TARGET_ESP32S3
+    -DBOARD_MY_MACHINE
+    -DOVERRIDE_MY_MACHINE
+    -DHW_WATCHDOG_PUMP_PIN=GPIO_NUM_13
+    -DWIFI_ENABLE=1
+    -DNETWORKING_ENABLE=1
+    -DTELNET_ENABLE=1
+    -DWEBSOCKET_ENABLE=1
+    -DHTTP_ENABLE=1
+    -DWEBUI_ENABLE=3
+    -DLITTLEFS_ENABLE=2
+    -DCONTROL_ENABLE=0
+    -DPROBE_ENABLE=0
+    -DDRIVER_SPINDLE_ENABLE=3
+    -DSDCARD_ENABLE=1
+    -DMDNS_ENABLE=1
+    -DDEFAULT_LASER_MODE=1
+    -DDEFAULT_SPINDLE_RPM_MAX=1000.0f
+    -DDEFAULT_SPINDLE_PWM_FREQ=1000
+    -DDEFAULT_STEPPER_IDLE_LOCK_TIME=255
+    -DDEFAULT_X_STEPS_PER_MM=80.0
+    -DDEFAULT_Y_STEPS_PER_MM=80.0
+    -DDEFAULT_Z_STEPS_PER_MM=80.0
+    -DDEFAULT_X_MAX_RATE=6000.0
+    -DDEFAULT_Y_MAX_RATE=6000.0
+    -DDEFAULT_Z_MAX_RATE=600.0
+    -DDEFAULT_X_ACCELERATION=500.0
+    -DDEFAULT_Y_ACCELERATION=500.0
+    -DDEFAULT_Z_ACCELERATION=100.0
+    -DDEFAULT_X_MAX_TRAVEL=410.0
+    -DDEFAULT_Y_MAX_TRAVEL=400.0
+    -DDEFAULT_Z_MAX_TRAVEL=10.0
+    -DDEFAULT_HOMING_ENABLE=1
+    -DDEFAULT_HOMING_INIT_LOCK=0
+    -DDEFAULT_HOMING_SINGLE_AXIS_COMMANDS=1
+    -DDEFAULT_HOMING_CYCLE_0=2
+    -DDEFAULT_HOMING_CYCLE_1=1
+    -DDEFAULT_HOMING_PULLOFF=3
+    -DDEFAULT_HOMING_SEEK_RATE=1500
+    -DDEFAULT_HOMING_FEED_RATE=100
+    -DDEFAULT_SOFT_LIMIT_ENABLE=0
+    -DDEFAULT_HARD_LIMIT_ENABLE=0
+    -DBUILD_INFO='"VEVOR A7 custom by Vlad+Claude"'
+
+board_build.flash_mode = dio
+board_build.f_flash = 40000000L
+board_upload.flash_size = 8MB
+monitor_speed=115200
+
+lib_compat_mode = off
