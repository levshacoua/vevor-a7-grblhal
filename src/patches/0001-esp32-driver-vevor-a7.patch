diff --git a/main/driver.c b/main/driver.c
index fb6ca97..b1fdf07 100644
--- a/main/driver.c
+++ b/main/driver.c
@@ -163,7 +163,7 @@ static pwm_spindle_t pwm_spindle = {
     .channel = {
         .gpio_num = SPINDLE_PWM_PIN,
 #if CONFIG_IDF_TARGET_ESP32S3
-        .speed_mode = LEDC_SPEED_MODE_MAX,
+        .speed_mode = LEDC_LOW_SPEED_MODE,
 #else
         .speed_mode = LEDC_HIGH_SPEED_MODE,
 #endif
@@ -199,7 +199,7 @@ static pwm_spindle_t pwm_spindle1 = {
     .channel = {
         .gpio_num = SPINDLE1_PWM_PIN,
 #if CONFIG_IDF_TARGET_ESP32S3
-        .speed_mode = LEDC_SPEED_MODE_MAX,
+        .speed_mode = LEDC_LOW_SPEED_MODE,
 #else
         .speed_mode = LEDC_HIGH_SPEED_MODE,
 #endif
@@ -3414,6 +3414,39 @@ bool driver_init (void)
 
     rtc_clk_cpu_freq_get_config(&cpu);
 
+#ifdef HW_WATCHDOG_PUMP_PIN
+    // VEVOR A7: charge-pump watchdog needs a continuous square wave from power-up.
+    {
+        ledc_timer_config_t wd_timer = {
+            .speed_mode = LEDC_LOW_SPEED_MODE,
+            .duty_resolution = LEDC_TIMER_8_BIT,
+            .timer_num = LEDC_TIMER_3,
+            .freq_hz = 8000,
+            .clk_cfg = LEDC_AUTO_CLK
+        };
+        ledc_timer_config(&wd_timer);
+        ledc_channel_config_t wd_channel = {
+            .gpio_num = HW_WATCHDOG_PUMP_PIN,
+            .speed_mode = LEDC_LOW_SPEED_MODE,
+            .channel = LEDC_CHANNEL_7,
+            .timer_sel = LEDC_TIMER_3,
+            .duty = 128,
+            .hpoint = 0
+        };
+        ledc_channel_config(&wd_channel);
+    }
+#if (DRIVER_SPINDLE_ENABLE & SPINDLE_PWM) && defined(SPINDLE_PWM_PIN)
+    // VEVOR A7: the laser pad is left in hardware HOLD by boot - release before LEDC claims it.
+    gpio_hold_dis(SPINDLE_PWM_PIN);
+    gpio_reset_pin(SPINDLE_PWM_PIN);
+    // keep the laser TTL line firmly LOW until the spindle PWM attaches
+    gpio_pullup_dis(SPINDLE_PWM_PIN);
+    gpio_pulldown_en(SPINDLE_PWM_PIN);
+    gpio_set_direction(SPINDLE_PWM_PIN, GPIO_MODE_OUTPUT);
+    gpio_set_level(SPINDLE_PWM_PIN, 0);
+#endif
+#endif
+
 #if CONFIG_IDF_TARGET_ESP32S3
     hal.info = "ESP32-S3";
 #else
