-    
-        wifi.sta.network.ip_mode = IpMode_DHCP; // For now...
+        // VEVOR A7: honor the configured STA IP mode ($321) instead of forcing DHCP.
+        // The DHCP *client* must be stopped before a static address can be set.
+        esp_netif_dhcpc_stop(sta_netif);
+
+        if(wifi.sta.network.ip_mode > IpMode_DHCP) // AutoIP not supported
+            wifi.sta.network.ip_mode = IpMode_DHCP;
 
         if(init_adapter(sta_netif, &wifi.sta.network))
-            esp_netif_dhcps_start(sta_netif);
+            esp_netif_dhcpc_start(sta_netif);
 
         memset(&wifi_sta_config, 0, sizeof(wifi_config_t));
 
